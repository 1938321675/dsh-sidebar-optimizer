{
  "name": "dsh-sidebar-optimizer",
  "version": "0.1.0",
  "description": "DSH 左侧栏入口区优化：整块折叠 + 单个入口收纳，状态持久化",
  "type": "module",
  "main": "./lib/index.js",
  "files": [
    "lib/",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "sidebar",
    "deepseek-harness"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/1938321675/dsh-sidebar-optimizer.git"
  },
  "homepage": "https://github.com/1938321675/dsh-sidebar-optimizer#readme",
  "bugs": {
    "url": "https://github.com/1938321675/dsh-sidebar-optimizer/issues"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs"
  },
  "license": "MIT"
}
